# =============================================================================
# Orquestador Agéntico — configuración
# Copiá este archivo a `.env` y completá los valores. `.env` está git-ignored.
# =============================================================================

# --- Proveedores LLM ---------------------------------------------------------
# Configurá al menos uno. Cada agente elige su proveedor y modelo por separado,
# así que podés mezclar: modelos baratos para roles rutinarios, frontier para
# decisiones ejecutivas.

# OpenRouter — acceso a cientos de modelos con una sola key.
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Anthropic directo (opcional)
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI directo (opcional)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Ollama local (opcional) — modelos locales, costo cero.
# Dejalo vacío para desactivar el proveedor.
OLLAMA_BASE_URL=http://localhost:11434

# --- Atribución en OpenRouter (opcional) -------------------------------------
# Aparecen en el ranking público de OpenRouter. Sin efecto funcional.
APP_URL=http://localhost:5173
APP_TITLE=Orquestador Agentico

# --- Servidor ----------------------------------------------------------------
PORT=3001
DATABASE_URL=./data/orquestador.db

# Dónde se guardan los Word y PDF que generan las habilidades de los agentes.
EXPORTS_DIR=./data/exports

# --- Límites de seguridad ----------------------------------------------------
# Tope de gasto por corrida en USD. El motor aborta la corrida al superarlo.
# Es la última red de contención: configurá también un límite en el dashboard
# de tu proveedor.
DEFAULT_RUN_BUDGET_USD=1.00

# Máximo de ticks por corrida antes de detenerse.
DEFAULT_MAX_TICKS=50

# Turnos de agente ejecutados en paralelo dentro de un tick.
AGENT_CONCURRENCY=4
# API de NVIDIA (build.nvidia.com): modelos sin costo con límites de tasa.
NVIDIA_API_KEY=
