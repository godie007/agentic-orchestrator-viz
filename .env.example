# =============================================================================
# Orquestador Agéntico — configuración
# Copiá este archivo a `.env` y completá los valores. `.env` está git-ignored.
# =============================================================================

# --- Proveedores LLM ---------------------------------------------------------
# Configurá al menos uno. Cada agente elige su proveedor y modelo por separado,
# así que podés mezclar: modelos baratos para roles rutinarios, frontier para
# decisiones ejecutivas.

# OpenRouter — acceso a cientos de modelos con una sola key.
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Anthropic directo (opcional)
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI directo (opcional)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Ollama local (opcional) — modelos locales, costo cero.
# Dejalo vacío para desactivar el proveedor.
OLLAMA_BASE_URL=http://localhost:11434

# --- Atribución en OpenRouter (opcional) -------------------------------------
# Aparecen en el ranking público de OpenRouter. Sin efecto funcional.
APP_URL=http://localhost:5173
APP_TITLE=Orquestador Agentico

# --- Servidor ----------------------------------------------------------------
PORT=3001
DATABASE_URL=./data/orquestador.db

# Dónde se guardan los Word y PDF que generan las habilidades de los agentes.
EXPORTS_DIR=./data/exports

# Carpeta con las pistas de música de fondo de los videos. Las dejás vos: la
# música tiene licencia, y el orquestador no puede saber cuál. El clima se lee
# del nombre del archivo, así que `corporativo-calmo.mp3` responde a un guion
# que pide "corporativo" o "calmo". Si la carpeta no existe, los videos salen
# sin música y todo lo demás funciona igual.
MUSICA_DIR=./data/musica

# --- Límites de seguridad ----------------------------------------------------
# Tope de gasto por corrida en USD. El motor aborta la corrida al superarlo.
# Es la última red de contención: configurá también un límite en el dashboard
# de tu proveedor.
DEFAULT_RUN_BUDGET_USD=1.00

# Máximo de ticks por corrida antes de detenerse.
DEFAULT_MAX_TICKS=50

# Turnos de agente ejecutados en paralelo dentro de un tick.
AGENT_CONCURRENCY=4
# API de NVIDIA (build.nvidia.com): modelos sin costo con límites de tasa.
NVIDIA_API_KEY=

# --- Imágenes generadas ------------------------------------------------------
# Con esto, un guion puede pedir `![lo que se ve](generar)` y el video la
# produce. Se usa el primer proveedor que tenga credencial, en este orden:
# Google (Gemini, centavos por imagen), OpenAI, y NVIDIA (FLUX, nivel gratuito).
# Sin ninguna, los videos usan sólo las imágenes que ya estén en el directorio
# de salida y se avisa cuáles no se pudieron mostrar.
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- Misiones programadas y correo ------------------------------------------

# Webhook del flujo de n8n que despacha el correo. El orquestador no habla SMTP:
# le pasa el mensaje al flujo y ese decide con qué cuenta sale.
#
# Contrato del POST:
#   { to: ["x@y.com"], subject: "...", text: "...",
#     attachments: [{ filename: "video.mp4", url: "https://..." }],
#     source: "orquestador-agentico" }
#
# Sin esto las misiones corren igual, pero no avisan, y send_email falla
# diciendo exactamente eso.
N8N_EMAIL_WEBHOOK_URL=

# Base pública de la API, para los enlaces de descarga que viajan en los avisos.
# Apunta al servidor local: el enlace se abre desde la misma máquina o red.
API_URL=http://localhost:3001

# Cada cuánto se revisa si a alguna misión le toca correr, en ms.
MISION_TICK_MS=30000
